generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  mobile                String                 @unique
  email                 String                 @unique
  password              String
  profileImage          String?
  verifiedEmail         Boolean                @default(false)
  verifiedMobile        Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  goals                 Goal[]
  goalsHistory          GoalHistory[]
  tokens                Token[]
  transactions          Transaction[]
  budgets               Budgets[]
  settings              Settings[]
  recurringTransactions RecurringTransaction[]
  otp                   OTPVerification[]
}

model Token {
  id           String   @id @default(uuid())
  userId       String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OTPVerification {
  id        String   @id @default(uuid())
  userId    String?
  email     String?
  mobile    String?
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([mobile])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  transactionType TransactionType @default(EXPENSE)
  amount          Decimal         @db.Decimal(10, 2)
  message         String
  transactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        String

  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecurringTransaction {
  id              String          @id @default(uuid())
  userId          String
  transactionType TransactionType @default(EXPENSE)
  amount          Decimal         @db.Decimal(10, 2)
  message         String
  category        String
  frequency       Frequency
  startDate       DateTime
  endDate         DateTime?
  nextRunDate     DateTime
  isActive        Boolean         @default(true)
  transactions    Transaction[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Goal {
  id            String        @id @default(uuid())
  userId        String
  goalAmount    Decimal       @db.Decimal(10, 2)
  currentAmount Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  title         String
  goalStatus    GoalStatus?   @default(ACTIVE)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalHistory   GoalHistory[]

  @@index([userId])
}

model GoalHistory {
  id        String   @id @default(uuid())
  userId    String
  goalId    String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId])
}

model Budgets {
  id       String       @id @default(uuid())
  userId   String
  category String
  amount   Decimal      @db.Decimal(10, 2)
  period   Period       @default(MONTHLY)
  status   BudgetStatus @default(ON_TRACK)
  alert    String
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Settings {
  id                                String   @id @default(uuid())
  userId                            String   @unique
  currency                          Currency @default(INR)
  enable_monthly_transaction_report Boolean  @default(false)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Currency {
  USD
  EUR
  INR
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Period {
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetStatus {
  ON_TRACK
  WARNING
  EXCEEDED
}

enum GoalStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}
